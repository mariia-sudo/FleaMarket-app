# Copy to .env — the defaults below are enough to run everything locally.

DATABASE_URL="file:./dev.db"
PORT=4000

# Must be set in production. Development falls back to an insecure default.
# JWT_SECRET="generate-with-openssl-rand-hex-32"

# Where the API is reachable from the phone. On a simulator localhost is fine;
# on a real device put your Mac's LAN IP here (e.g. http://192.168.1.20:4000)
# so uploaded photo URLs resolve.
PUBLIC_URL="http://localhost:4000"

# Deep link scheme the Stripe Checkout redirect bounces back into.
APP_SCHEME="fleamarket"

# Leave both blank to run the wallet in SANDBOX mode: top-ups credit coins
# instantly and payouts are marked paid without money moving. Fill them in with
# Stripe *test* keys to exercise the real Checkout + Connect flow.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
