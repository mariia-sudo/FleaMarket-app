# Copy to .env.

# Postgres in development too, on purpose — see the note in prisma/schema.prisma.
# Local Homebrew Postgres, where the database is owned by your macOS user:
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/fleamarket"

PORT=4000

# Where this API is reachable from the outside. Photo URLs are built from it, and
# Stripe redirects come back to it, so `localhost` breaks the moment anything but
# a simulator talks to the server. On a LAN use your Mac's IP.
# Required in production — the process refuses to start without it.
PUBLIC_URL="http://192.168.1.35:4000"

# Deep link scheme the Stripe Checkout redirect bounces back into.
APP_SCHEME="fleamarket"

# Where listing photos are written. In a container this MUST be a mounted
# persistent volume, otherwise every deploy deletes every photo.
UPLOAD_DIR="uploads"

# Must be set in production. Development falls back to an insecure default.
# Generate with: openssl rand -hex 32
# JWT_SECRET=""

# Leave both blank to run the wallet in SANDBOX mode: top-ups credit coins
# instantly and payouts are marked paid without money moving. Fill them in with
# Stripe *test* keys to exercise the real Checkout + Connect flow.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
