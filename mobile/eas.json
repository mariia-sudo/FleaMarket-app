{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.35:4000"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-DEPLOYED-API"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-DEPLOYED-API"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "FX28Z4P756",
        "ascApiKeyPath": "./credentials/AuthKey_REPLACE.p8",
        "ascApiKeyId": "REPLACE",
        "ascApiKeyIssuerId": "REPLACE"
      }
    }
  }
}
