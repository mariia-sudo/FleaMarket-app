# Copy to .env.
#
# Where the API lives. Baked in at build time (EXPO_PUBLIC_ prefix).
#
# Development on a simulator: leave this out entirely, the app works it out from
# the Expo dev server.
# Development on a real phone, or any Release build: set it to the machine
# running the API, e.g. http://192.168.1.35:4000
# Production: your deployed API, e.g. https://api.fleamarket.app
EXPO_PUBLIC_API_URL=http://192.168.1.35:4000
