{
  "expo": {
    "name": "FleaMarket",
    "slug": "fleamarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mashaegorova.fleamarket",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "FleaMarket connects to the marketplace server running on your computer."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mashaegorova.fleamarket"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "scheme": "fleamarket",
    "experiments": {
      "typedRoutes": true
    }
  }
}
